{
    "name": "javaabu/notifications",
    "description": "Notifications for Laravel: define a message once for mail, database, broadcast, FCM and SMS, with notification pages, a live bell, branded mail and Dhivehi support",
    "homepage": "https://github.com/Javaabu/notifications",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "notifications",
        "mail",
        "sms",
        "fcm",
        "reverb"
    ],
    "authors": [
        {
            "name": "Arushad Ahmed",
            "email": "arushad@javaabu.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/forms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/manifest"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/permissions"
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/translatable"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/broadcasting": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/mail": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "javaabu/forms": "^2.0@dev",
        "javaabu/manifest": "^1.0@dev",
        "javaabu/permissions": "^3.0@dev",
        "javaabu/sms-notifications": "^1.3"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "javaabu/boost-javaabu-guidelines": "^1.0",
        "javaabu/translatable": "^3.0@dev",
        "laravel-notification-channels/fcm": "^6.0",
        "laravel/pint": "^1.24",
        "laravel/reverb": "^1.12",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8"
    },
    "suggest": {
        "javaabu/translatable": "Stores database notifications in every active language and checks notifiable locales against them (^3.0)",
        "laravel-notification-channels/fcm": "Sends notifications as Firebase Cloud Messaging push messages through the fcm channel (^6.0)",
        "laravel/reverb": "Pushes new notifications to the bell live; it polls without it (^1.12)",
        "inertiajs/inertia-laravel": "Renders the notification pages with Inertia React when notifications.views is inertia (^2.0)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\Notifications\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover build/coverage.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\Notifications\\NotificationsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
